# --- Speech (Gnani only) ---
GNANI_API_KEY=
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_LANGUAGE=en-IN

# --- Dataset (do not copy the dataset into the repo) ---
# Absolute path or path relative to the repo root.
DATA_DIR=

# --- LLM (hosted, OpenAI-compatible) ---
# llm7 is free and needs no key. Other options: pollinations, openai, groq,
# gemini, ollama, openrouter, none.
LLM_PROVIDER=llm7
LLM_MODEL=DeepSeek-V4-Flash-0731
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=90
LLM_TEMPERATURE=0.2

# Free fallback with no key (rate limited to 1 request / 30 s).
LLM_FALLBACK_PROVIDER=pollinations
LLM_FALLBACK_MODEL=openai-fast

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BACKEND=auto
INDEX_DIR=.index_cache

# --- Agent ---
REFERENCE_DATE=2026-10-20
RETRIEVAL_TOP_K=8
